                  "});\r",
                  "\r",
                  "// Contrato: validar que existe 'detail' y es un array\r",
                  "pm.test(\"El body de la respuesta contiene un arreglo 'detail'.\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"detail\");\r",
                  "    pm.expect(jsonData.detail).to.be.an(\"array\").that.is.not.empty;\r",
                  "});\r",
                  "\r",
                  "// Formato: validar estructura del objeto dentro de detail\r",
                  "pm.test(\"El objeto dentro de 'detail' tiene los campos correctos.\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    let errorObj = jsonData.detail[0]; // primer error\r",
                  "\r",
                  "    pm.expect(errorObj).to.have.property(\"type\").that.is.a(\"string\");\r",
                  "    pm.expect(errorObj).to.have.property(\"loc\").that.is.an(\"array\");\r",
                  "    pm.expect(errorObj).to.have.property(\"msg\").that.is.a(\"string\");\r",
                  "    pm.expect(errorObj).to.have.property(\"input\").that.is.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "// Contenido: validar que el error corresponde a int_parsing\r",
                  "pm.test(\"El tipo de error y el mensaje son correctos.\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    let errorObj = jsonData.detail[0];\r",
                  "\r",
                  "    pm.expect(errorObj.type).to.equal(\"int_parsing\");\r",
                  "    pm.expect(errorObj.msg).to.include(\"unable to parse string as an integer\");\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
