    {
      "name": "Products",
      "item": [
        {
          "name": "TC-15: Listar todos los productos con paginación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Definir jsonData una sola vez\r",
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "// Estado HTTP\r",
                  "pm.test(\"El código de estado es 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Contrato: validar que existen las claves principales\r",
                  "pm.test(\"El body contiene las claves requeridas.\", function () {\r",
                  "    pm.expect(jsonData).to.have.keys([\"total\",\"skip\",\"limit\",\"data\"]);\r",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "// Formato: validar tipos de datos principales\r",
                  "pm.test(\"Los campos principales tienen el formato correcto.\", function () {\r",
                  "    pm.expect(jsonData.total).to.be.a(\"number\");\r",
                  "    pm.expect(jsonData.skip).to.be.a(\"number\");\r",
                  "    pm.expect(jsonData.limit).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "// Contenido: validar coherencia de paginación\r",
                  "pm.test(\"El número de elementos en 'data' coincide con 'limit'.\", function () {\r",
                  "    pm.expect(jsonData.data.length).to.equal(jsonData.limit);\r",
                  "});\r",
                  "\r",
                  "// Validar estructura de cada objeto en data\r",
                  "pm.test(\"Cada objeto en 'data' tiene los campos requeridos.\", function () {\r",
                  "    let regexObjectId = /^[0-9a-fA-F]{24}$/;\r",
                  "\r",
                  "    jsonData.data.forEach(obj => {\r",
                  "        pm.expect(obj).to.have.property(\"_id\").that.matches(regexObjectId);\r",
                  "        pm.expect(obj).to.have.property(\"codigo_mongo\").that.is.a(\"string\");\r",
                  "        pm.expect(obj).to.have.property(\"nombre\").that.is.a(\"string\");\r",
                  "        pm.expect(obj).to.have.property(\"categoria\").that.is.a(\"string\");\r",
                  "        pm.expect(obj).to.have.property(\"equivalencias\").that.is.an(\"object\");\r",
                  "\r",
                  "        // Validar equivalencias\r",
                  "        pm.expect(obj.equivalencias).to.have.property(\"codigo_alt\").that.is.a(\"string\");\r",
                  "\r",
                  "        // sku es opcional, si existe debe ser string\r",
                  "        if (obj.equivalencias.hasOwnProperty(\"sku\")) {\r",
                  "            pm.expect(obj.equivalencias.sku).to.be.a(\"string\");\r",
                  "        }\r",
                  "    });\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
