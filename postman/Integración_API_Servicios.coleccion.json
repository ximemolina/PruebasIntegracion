              "host": ["{{baseUrl}}"],
              "path": ["order", "{{order_id}}"],
              "variable": [
                {
                  "key": "order_id",
                  "value": ""
                }
              ]
            },
            "description": "Update an existing order by its ID"
          }
        },
        {
          "name": "Delete order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/order/{{order_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["order", "{{order_id}}"],
              "variable": [
                {
                  "key": "order_id",
                  "value": ""
