                  "        pm.expect(errorObj).to.have.property(\"loc\").that.is.an(\"array\");\r",
                  "        pm.expect(errorObj).to.have.property(\"msg\").that.is.a(\"string\");\r",
                  "        pm.expect(errorObj).to.have.property(\"input\");\r",
                  "        pm.expect(errorObj).to.have.property(\"ctx\").that.is.an(\"object\");\r",
                  "    });\r",
                  "\r",
                  "} else {\r",
                  "    // Si no es ni string ni array, falla el test\r",
                  "    pm.expect.fail(\"El campo 'detail' no es ni string ni array válido.\");\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  ""
