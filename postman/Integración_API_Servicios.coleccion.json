                  "});\r",
                  "\r",
                  "// Validación flexible: 'detail' puede ser string o array\r",
                  "let jsonData = pm.response.json();\r",
                  "if (typeof jsonData.detail === \"string\") {\r",
                  "    // Caso: detail es un string\r",
                  "    //pm.expect(jsonData.detail).to.include(\"must be a valid ObjectId\");\r",
                  "    pm.test(\"El campo 'detail' es un string y el mensaje de error indica que el cliente_id/producto_id debe ser un ObjectId.\", function () {\r",
                  "        let jsonData = pm.response.json();\r",
                  "        pm.expect(jsonData.detail).to.include(\"must be a valid ObjectId\");\r",
                  "    });\r",
                  "} else if (Array.isArray(jsonData.detail)) {\r",
                  "    // Caso: detail es un array\r",
                  "    pm.test(\"El campo 'detail' es un array válido no vacío y los valores de su objeto tiene las propiedades correctas.\", function () {\r",
                  "        pm.expect(jsonData.detail).to.be.an(\"array\").that.is.not.empty;\r",
